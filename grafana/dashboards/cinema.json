{
  "uid": "online-cinema",
  "title": "Online Cinema Analytics",
  "schemaVersion": 41,
  "timezone": "utc",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Retention Cohort Heatmap",
      "description": "Строка — дата первого просмотра UTC. Цвет — доля вернувшихся, прочерк — день ещё не наступил.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "uid": "cinema-clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "datasource": {
            "uid": "cinema-clickhouse",
            "type": "grafana-clickhouse-datasource"
          },
          "rawSql": "SELECT toString(metric_date) AS Cohort,\n       maxIf(value, metric = 'retention_d0') AS `Day 0`,\n       maxIf(value, metric = 'retention_d1') AS `Day 1`,\n       maxIf(value, metric = 'retention_d2') AS `Day 2`,\n       maxIf(value, metric = 'retention_d3') AS `Day 3`,\n       maxIf(value, metric = 'retention_d4') AS `Day 4`,\n       maxIf(value, metric = 'retention_d5') AS `Day 5`,\n       maxIf(value, metric = 'retention_d6') AS `Day 6`,\n       maxIf(value, metric = 'retention_d7') AS `Day 7`\nFROM cinema.daily_metrics\nWHERE $__dateFilter(metric_date) AND metric LIKE 'retention_d%'\nGROUP BY metric_date\nHAVING isNotNull(`Day 0`)\nORDER BY metric_date DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Day [0-7]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "dark-gray",
                      "value": null
                    },
                    {
                      "color": "#283f67",
                      "value": 0
                    },
                    {
                      "color": "#176596",
                      "value": 0.25
                    },
                    {
                      "color": "#247d7b",
                      "value": 0.5
                    },
                    {
                      "color": "#3c905a",
                      "value": 0.75
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Активные пользователи (DAU)",
      "datasource": {
        "uid": "cinema-clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "datasource": {
            "uid": "cinema-clickhouse",
            "type": "grafana-clickhouse-datasource"
          },
          "rawSql": "SELECT toDateTime(metric_date, 'UTC') AS time, value AS dau\nFROM cinema.daily_metrics\nWHERE metric = 'dau' AND $__dateFilter(metric_date)\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Конверсия просмотра",
      "datasource": {
        "uid": "cinema-clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "datasource": {
            "uid": "cinema-clickhouse",
            "type": "grafana-clickhouse-datasource"
          },
          "rawSql": "SELECT toDateTime(metric_date, 'UTC') AS time, value AS view_conversion\nFROM cinema.daily_metrics\nWHERE metric = 'view_conversion' AND $__dateFilter(metric_date)\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "bars"
          }
        },
        "overrides": []
      }
    }
  ]
}
